rules_version = '2';
// Blobs are encrypted on the device with a random key that is only shared
// inside the end-to-end encrypted message; blob IDs are random.
service firebase.storage {
  match /b/{bucket}/o {
    match /blobs/{blobId} {
      allow get: if request.auth != null && request.auth.token.nid is string;
      allow create: if request.auth != null && request.auth.token.nid is string
        && resource == null
        && request.resource.size < 100 * 1024 * 1024
        && blobId.matches('[A-Za-z0-9_-]{16,64}');
      allow list, update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
